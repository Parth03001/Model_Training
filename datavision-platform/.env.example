# =============================================================================
# DataVision Platform - Environment Configuration
# =============================================================================

# --- Database ---
POSTGRES_USER=datavision
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=datavision
DATABASE_URL=postgresql+asyncpg://datavision:changeme_in_production@db:5432/datavision

# --- Redis (Celery broker + cache) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Storage ---
UPLOAD_DIR=/data/uploads
MODEL_DIR=/data/models
EXPORT_DIR=/data/exports

# --- Auto-Annotation Models ---
# Grounding DINO
GROUNDING_DINO_MODEL=IDEA-Research/grounding-dino-base
GROUNDING_DINO_BOX_THRESHOLD=0.3
GROUNDING_DINO_TEXT_THRESHOLD=0.25

# SAM 2
SAM2_MODEL=facebook/sam2-hiera-large
SAM2_CHECKPOINT=sam2_hiera_large.pt

# CLIP (for visual similarity search)
CLIP_MODEL=openai/clip-vit-large-patch14
FAISS_INDEX_DIR=/data/faiss_indices

# --- Training Defaults ---
DEFAULT_EPOCHS=100
DEFAULT_BATCH_SIZE=16
DEFAULT_IMG_SIZE=640
DEFAULT_PATIENCE=20

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
VITE_API_URL=http://localhost:8000
